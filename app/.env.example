# Configuração PÚBLICA do app Firebase (Console > Configurações do projeto > Seus apps).
# Estes valores não são segredos, mas o arquivo .env não é versionado.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-vai-chover
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Desenvolvimento local com Firebase Emulator Suite
EXPO_PUBLIC_USE_EMULATORS=true
# 10.0.2.2 = máquina host vista do emulador Android; use o IP da rede para aparelho físico
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2

# Segredos das Cloud Functions NÃO ficam aqui. Use:
#   firebase functions:secrets:set OTP_PEPPER
#   firebase functions:secrets:set SMTP_CONNECTION_URI
