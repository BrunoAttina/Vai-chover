# Extensão Trigger Email (firebase/firestore-send-email) — fila na coleção `mail`.
# O valor de SMTP_CONNECTION_URI é um segredo e fica no Secret Manager:
#   firebase ext:configure firestore-send-email  (ou definido no deploy, quando solicitado)
FIRESTORE_INSTANCE_ID=(default)
FIRESTORE_INSTANCE_LOCATION=southamerica-east1
MAIL_COLLECTION=mail
DEFAULT_FROM=Vai chover? <nao-responda@vaichover.app>
DATABASE_REGION=southamerica-east1
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
TLS_OPTIONS={}
