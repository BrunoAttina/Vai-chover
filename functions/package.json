    "firebase": "^13.4.0",
    "jest": "^30.2.0",
    "nock": "^14.0.0",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.0",
    "babel-jest": "^30.2.0"
